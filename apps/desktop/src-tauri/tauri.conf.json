{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLens",
  "version": "0.1.3",
  "identifier": "com.paperlens.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLens",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://api.openalex.org https://api.crossref.org https://api.datacite.org https://api.unpaywall.org https://api.core.ac.uk https://www.ebi.ac.uk https://api.mymemory.translated.net https://zh.wikipedia.org https://en.wikipedia.org",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
